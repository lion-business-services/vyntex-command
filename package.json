{
  "name": "vyntex-platform",
  "version": "1.0.0",
  "private": true,
  "description": "VYNTEX business operations platform: one core, industry packs, tenant-ready. Demo mode + sales site.",
  "type": "module",
  "scripts": {
    "build": "node scripts/build.mjs",
    "build:lbs": "node scripts/build.mjs --deploy lbs",
    "dev": "node scripts/build.mjs --watch & node scripts/serve.mjs",
    "start": "node scripts/serve.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "check:pricing": "node scripts/check-pricing.mjs",
    "typecheck:local": "tsc --noEmit -p tsconfig.local.json",
    "check": "node scripts/check-pricing.mjs && node scripts/check-i18n.mjs && node scripts/check-seeds.mjs",
    "build:preview": "node scripts/build-preview.mjs",
    "test:db": "bash supabase/tests/run_local.sh",
    "test:unit": "node --test tests/unit/*.test.mjs",
    "test:split": "node tests/deploy_split.mjs",
    "test:server": "node tests/server/run.mjs",
    "test:e2e": "node tests/e2e/run.mjs",
    "dev:stack": "node scripts/dev-supabase.mjs --stack",
    "test:security": "node --test \"tests/security/*.test.mjs\"",
    "test:restore": "bash scripts/backup/restore-test.sh",
    "security:secrets": "node scripts/security/scan-secrets.mjs",
    "security:pii": "node scripts/security/scan-pii.mjs",
    "security:bundle": "node scripts/security/scan-bundle.mjs dist --deploy vyntex && node scripts/security/scan-bundle.mjs dist-lbs --deploy lbs",
    "security:headers": "node scripts/security/check-headers.mjs",
    "security:evidence": "node scripts/security/check-evidence.mjs",
    "test:integrations": "node --test --test-concurrency=1 tests/integrations/*.test.mjs",
    "test:migrate": "node tests/migrate/run.mjs",
    "migrate:nova:preflight": "node tools/migrate-nova/00-preflight.mjs",
    "migrate:nova:extract": "node tools/migrate-nova/10-extract.mjs",
    "migrate:nova:map": "node tools/migrate-nova/20-map.mjs",
    "migrate:nova:validate": "node tools/migrate-nova/30-validate.mjs",
    "migrate:nova:dry-run": "node tools/migrate-nova/40-dry-run.mjs",
    "migrate:nova:apply": "node tools/migrate-nova/50-apply.mjs",
    "migrate:nova:reconcile": "node tools/migrate-nova/60-reconcile.mjs",
    "migrate:nova:rollback": "node tools/migrate-nova/70-rollback.mjs",
    "qa:facts": "node tests/pack_facts.mjs",
    "qa:matrix": "python3 tests/qa_matrix.py",
    "qa:flows": "python3 tests/qa_flows.py",
    "qa:motion": "python3 tests/qa_motion.py"
  },
  "dependencies": {
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-icons": "^5.5.0",
    "pdf-lib": "^1.17.1"
  },
  "devDependencies": {
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "esbuild": "^0.27.0",
    "typescript": "^5.9.0"
  },
  "engines": {
    "node": ">=20"
  }
}
