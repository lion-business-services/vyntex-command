# Editor settings shared by everyone who opens this repository (VS Code reads this file with the EditorConfig
# extension). They match what the existing files use.
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

# Two trailing spaces mean a line break in Markdown.
[*.md]
trim_trailing_whitespace = false

[*.py]
indent_size = 4

[Makefile]
indent_style = tab
