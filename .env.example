# Environment variables for the VYNTEX platform.
# This file lists every variable with NO values. Never write a real value here and never commit a file that has one.
# Local use: copy this file to ".env.local" (ignored by Git) and fill it in.
# Production: IN the Vercel dashboard, Project, Settings, Environment Variables. Mark each secret as "Sensitive".
# Nothing below is needed to run the public demo: the demo works in the browser with no keys at all.

# --- Supabase (this product's OWN project, never shared with another VYNTEX system) ---
# Project URL, for example https://<project-ref>.supabase.co  (Supabase dashboard, Project Settings, API).
SUPABASE_URL=
# Public browser key (shown as "anon" or "publishable" in the dashboard). Safe in a browser ONLY because row level security is on.
SUPABASE_ANON_KEY=
# Server key (shown as "service_role" or "secret"). Bypasses row level security. Server functions only, never in browser code.
SUPABASE_SERVICE_ROLE_KEY=

# --- Demo request form (api/demo-request.js) ---
# Resend API key used to email each demo request.
RESEND_API_KEY=
# Where demo requests are sent. One address, or several separated by commas.
DEMO_REQUEST_TO=
# Sender shown on that email. Must be an address on a domain verified in Resend.
DEMO_REQUEST_FROM=
# Secret text (32 or more random characters) used to turn a visitor's network address into a keyed hash before storing it.
# Read by hashAddress() in api/_lib/request.js. Without it no address hash is stored at all.
IP_HASH_SALT=

# --- Assistant (api/assistant.js) ---
# Anthropic API key. Without it the Assistant page stays on the built-in assistant and says so.
ANTHROPIC_API_KEY=
# Optional. Model id for the assistant. Leave empty to use the default set in api/assistant.js.
ASSISTANT_MODEL=

# --- Encryption of sensitive personal data (worker tax IDs) ---
# Recommended setup does NOT use this variable: the key lives in Supabase Vault as a secret named "pii_encryption_key"
# and never leaves the database (see docs/SECURITY.md). Fill this only for the alternative setup on a self-managed
# Postgres, where the same value is set once as the database setting app.settings.pii_encryption_key.
# No application code reads it today. 32 or more random characters. Losing it makes the encrypted data unreadable.
PII_ENCRYPTION_KEY=

# --- Stripe (later, not used by any code yet) ---
# Start in TEST mode: use the test secret key (begins with sk_test_) until the owner approves going live.
# Stripe Tax stays OFF until the owner confirms the tax setup (pricing rules, config/vyntex-build-pricing.json).
STRIPE_SECRET_KEY=
# Signing secret of the Stripe webhook endpoint (begins with whsec_), test mode first.
STRIPE_WEBHOOK_SECRET=
