# Environment variables for the platform: names and explanations only.
# Never write a real value in this file and never commit a file that has one.
#
# There are TWO deployments of this code, and they share nothing:
#   VYNTEX Command   its own Vercel project and its own Supabase project
#   LBS Command      its own Vercel project and its own Supabase project
# Every variable below is set separately in each Vercel project (Settings, Environment Variables, marked "Sensitive"
# where it says secret). A value must never be copied from one deployment to the other, and a development or test
# value must never be used in production. The server checks a few of these rules at start and refuses to serve the
# workspace when one is broken (docs/SERVER.md, "Environment rules").
#
# Local use: `npm run dev:stack` needs none of these. It makes up throwaway values for one run.
# The public demo and the sales pages need none of these either.

# ----------------------------------------------------------------------------------------------------------------------
# Which deployment, which environment
# ----------------------------------------------------------------------------------------------------------------------
# vyntex or lbs. Read by the build (brand, routes) and by the server (product name in emails, sign-in rules).
VX_DEPLOY=
# Optional. local, development, preview, staging, production or test. When empty, Vercel's own VERCEL_ENV decides.
# "test" is for automated tests only: it turns on the OAuth test provider. A production deployment refuses to run with it.
VX_ENV=
# The one public address of this deployment, for example https://command.vyntexusa.com (no trailing slash).
# Used for the same-origin check on every request that changes something, and for links in emails. Required in production.
APP_ORIGIN=
# Build time only, lbs: links the team sends to clients often. Empty means the screen shows "not set".
VX_LINK_BOOKKEEPING=
VX_LINK_PAYROLL=
# Build time only, test builds of lbs: 1 adds the clearly labelled sample preview at /preview.
VX_SAMPLE_PREVIEW=

# ----------------------------------------------------------------------------------------------------------------------
# Supabase (this deployment's OWN project)
# ----------------------------------------------------------------------------------------------------------------------
# Project URL, https://<project-ref>.supabase.co (Supabase dashboard, Project Settings, API).
SUPABASE_URL=
# Public key ("anon" or "publishable"). Sent as the api key next to a person's own token. Not a secret.
SUPABASE_ANON_KEY=
# Secret. Server key ("service_role" or "secret"). Bypasses row level security. Server functions only.
SUPABASE_SERVICE_ROLE_KEY=

# ----------------------------------------------------------------------------------------------------------------------
# Sessions and stored tokens
# ----------------------------------------------------------------------------------------------------------------------
# Secret. 32 or more random characters. Seals the session cookie and signs csrf and OAuth state values.
SESSION_SECRET=
# Secret, optional. The value SESSION_SECRET had before its last change, so open sessions survive the change.
# Remove it a day later.
SESSION_SECRET_PREVIOUS=
# Optional. Longest life of a session in hours, whatever the activity. Default 12.
SESSION_MAX_HOURS=
# Secret. 32 random bytes, base64 encoded. Seals provider tokens before they are stored in the database.
# Losing it makes every stored connection unusable (people connect again). Keep a copy in the password manager.
TOKEN_ENC_KEY=
# Secret, optional. The value TOKEN_ENC_KEY had before its last change. Tokens sealed with it still open and are
# sealed again with the new key the next time they are used.
TOKEN_ENC_KEY_PREVIOUS=
# Secret. 32 or more random characters. Turns a network address or an email into a keyed hash for rate limits,
# security events and the audit trail. The address itself is never stored.
IP_HASH_SALT=
# Secret. 24 or more random characters. Vercel sends it with the scheduled calls to /api/cron/*
# (as "Authorization: Bearer <value>"). Anything without it is refused.
CRON_SECRET=

# ----------------------------------------------------------------------------------------------------------------------
# System email (invitations, password resets, security notices) through Resend
# ----------------------------------------------------------------------------------------------------------------------
# Secret. Resend API key. Also used by the demo request form.
RESEND_API_KEY=
# Sender of system email, on a domain verified in Resend, for example "VYNTEX Command <system@...>".
SYSTEM_EMAIL_FROM=
# Secret, optional. Signing secret of the Resend webhook (starts with whsec_). Needed only to receive delivery events
# at /api/webhooks/resend.
RESEND_WEBHOOK_SECRET=

# ----------------------------------------------------------------------------------------------------------------------
# Demo request form (vyntex only, api/demo-request.js)
# ----------------------------------------------------------------------------------------------------------------------
# Where demo requests are sent. One address, or several separated by commas.
DEMO_REQUEST_TO=
# Sender shown on that email. Must be on a domain verified in Resend.
DEMO_REQUEST_FROM=

# ----------------------------------------------------------------------------------------------------------------------
# Assistant (api/assistant.js)
# ----------------------------------------------------------------------------------------------------------------------
# Secret. Anthropic API key. Without it the Assistant page stays on the built-in assistant and says so.
ANTHROPIC_API_KEY=
# Optional. Model id for the assistant. Leave empty for the default set in api/assistant.js.
ASSISTANT_MODEL=
# Optional. Time limit of one model call in milliseconds. Default 25000.
AI_TIMEOUT_MS=

# ----------------------------------------------------------------------------------------------------------------------
# Providers (the Integrations screen)
# Every provider is optional. One whose settings are missing shows as "not connected, not configured" and names the
# missing settings. One that needs the provider's own review stays "pending approval" until its *_APPROVED variable
# is set to true, which is done only after the provider has approved the app. A connection is shown as connected
# only after the provider itself answered for the account. Details per provider: docs/integrations/*.md.
# ----------------------------------------------------------------------------------------------------------------------
# Google: Gmail, Calendar, Meet, Business Profile (docs/integrations/google.md)
# OAuth client of this deployment's Google Cloud project (Gmail, Calendar, Meet, Business Profile).
GOOGLE_CLIENT_ID=
# Secret. The secret of that OAuth client.
GOOGLE_CLIENT_SECRET=
# true once Google verified the app for the Gmail scopes. Until then Gmail shows "pending approval".
GOOGLE_GMAIL_APPROVED=
# true once Google verified the app for the Calendar scope. Also unlocks Meet.
GOOGLE_CALENDAR_APPROVED=
# true once Google granted this project access to the Business Profile APIs.
GOOGLE_GBP_APPROVED=
# Optional. Comma separated domains: only Google accounts in them may be connected.
GOOGLE_ALLOWED_DOMAINS=
# Optional. projects/<id>/topics/<name>, where Gmail publishes change notices. Without it the mailbox is polled.
GOOGLE_PUBSUB_TOPIC=
# Audience set on the Pub/Sub push subscription (the Gmail webhook address). Without it Gmail notices are refused.
GOOGLE_PUBSUB_AUDIENCE=
# Email of the service account the push subscription signs with. Without it Gmail notices are refused.
GOOGLE_PUBSUB_SERVICE_ACCOUNT=
# Optional. Full name of the subscription: when set, notices from any other are refused.
GOOGLE_PUBSUB_SUBSCRIPTION=
# Secret. 32 or more random characters. Signs the token of Calendar watch channels. Without it the calendar is polled and notices are refused.
GOOGLE_CHANNEL_SECRET=
# Optional. Name of the calendar created in the connected account. Default: the product name of the deployment.
GOOGLE_CALENDAR_NAME=

# Google Maps (docs/integrations/google.md)
# Secret. Server-side key restricted to the Geocoding API.
GOOGLE_MAPS_API_KEY=
# Optional. Geocoding requests per company per day. Default 200.
GOOGLE_MAPS_DAILY_CAP=

# Square (docs/integrations/square-quickbooks.md). Start in sandbox.
# The Square application id (the sandbox one starts with sandbox-).
SQUARE_APPLICATION_ID=
# Secret. The application secret: the code exchange, the refresh and the revoke call.
SQUARE_APPLICATION_SECRET=
# sandbox or production. No default: any other value stops every Square call.
SQUARE_ENVIRONMENT=
# Secret. The signature key of the webhook subscription.
SQUARE_WEBHOOK_SIGNATURE_KEY=
# Optional. The notification address exactly as registered at Square, when it is not APP_ORIGIN + /api/webhooks/square.
SQUARE_WEBHOOK_URL=
# Optional. code (default, the exchange is authenticated with the secret) or pkce.
SQUARE_OAUTH_FLOW=
# Optional. The Square-Version date sent with every call. The default is set in the adapter.
SQUARE_API_VERSION=
# Optional. A deployment that serves one company can name the only Square merchant it accepts.
SQUARE_EXPECTED_MERCHANT_ID=

# QuickBooks Online (docs/integrations/square-quickbooks.md). Start in sandbox.
# The Intuit app's client id (development or production keys).
QUICKBOOKS_CLIENT_ID=
# Secret. The client secret.
QUICKBOOKS_CLIENT_SECRET=
# sandbox or production. No default.
QUICKBOOKS_ENVIRONMENT=
# Secret. The verifier token of the app's webhooks.
QUICKBOOKS_WEBHOOK_VERIFIER_TOKEN=
# true once the app may be used with the keys in place. Until then nobody can connect.
QUICKBOOKS_APPROVED=
# Optional. The minorversion sent with every call. The default is set in the adapter.
QUICKBOOKS_MINOR_VERSION=

# Meta: Facebook Pages and Instagram (docs/integrations/messaging.md)
# Meta app id.
META_APP_ID=
# Secret. Meta app secret: the token exchange, and the signature of Meta and WhatsApp webhooks.
META_APP_SECRET=
# Secret. The value typed into Meta's webhook form for Page and Instagram.
META_WEBHOOK_VERIFY_TOKEN=
# true once App Review and Business Verification are done.
META_APPROVED=
# Optional. Facebook Login for Business configuration id.
META_LOGIN_CONFIG_ID=
# Optional. Graph API version. The default is set in the adapter.
META_GRAPH_VERSION=
# Optional. Oldest accepted Meta webhook body, in seconds. Default 129600.
META_WEBHOOK_MAX_AGE_S=

# WhatsApp Business (docs/integrations/messaging.md)
# Secret. The value typed into the WhatsApp webhook form.
WHATSAPP_WEBHOOK_VERIFY_TOKEN=
# Secret. Token of the system user.
WHATSAPP_SYSTEM_USER_TOKEN=
# The number messages are sent from.
WHATSAPP_PHONE_NUMBER_ID=
# The WhatsApp Business account that owns the number and the templates.
WHATSAPP_BUSINESS_ACCOUNT_ID=
# true once the business is verified and the number is live.
WHATSAPP_APPROVED=
# Optional. Oldest accepted WhatsApp webhook body, in seconds. Default 604800.
WHATSAPP_WEBHOOK_MAX_AGE_S=

# Dialpad (docs/integrations/messaging.md)
# oauth (default) or api_key.
DIALPAD_AUTH_MODE=
# OAuth mode: the client id.
DIALPAD_CLIENT_ID=
# Secret. OAuth mode: the client secret.
DIALPAD_CLIENT_SECRET=
# Secret. API key mode: the key.
DIALPAD_API_KEY=
# Secret. The value each company's webhook secret is made from.
DIALPAD_WEBHOOK_SECRET=
# OAuth mode: true once Dialpad approved the app.
DIALPAD_APPROVED=
# Optional. sandbox to use sandbox.dialpad.com.
DIALPAD_ENVIRONMENT=
# Optional. true to ask for text events and the text content scope.
DIALPAD_SMS_ENABLED=
# Optional. Oldest accepted Dialpad event, in seconds. Default 300.
DIALPAD_WEBHOOK_MAX_AGE_S=

# Text messages (docs/integrations/messaging.md)
# twilio or dialpad: which carrier sends text messages.
SMS_PROVIDER=
# The sending number, in E.164 form.
SMS_FROM_NUMBER=
# true once the sender registration is approved.
SMS_APPROVED=
# Twilio account id (when SMS_PROVIDER is twilio).
TWILIO_ACCOUNT_SID=
# Secret. Twilio auth token: API calls and the webhook signature.
TWILIO_AUTH_TOKEN=
# Optional. Send through a messaging service instead of one number.
TWILIO_MESSAGING_SERVICE_SID=

# ----------------------------------------------------------------------------------------------------------------------
# Kept in the database, not here
# ----------------------------------------------------------------------------------------------------------------------
# The key that encrypts tax IDs lives in Supabase Vault as a secret named "pii_encryption_key" and never leaves the
# database (docs/SECURITY.md). Fill this only for a self-managed Postgres, where the same value is set once as the
# database setting app.settings.pii_encryption_key. No application code reads it.
PII_ENCRYPTION_KEY=

# ----------------------------------------------------------------------------------------------------------------------
# Stripe (later, not used by any code yet)
# ----------------------------------------------------------------------------------------------------------------------
# Start in TEST mode: the test secret key (begins with sk_test_) until the owner approves going live.
# Stripe Tax stays OFF until the owner confirms the tax setup (pricing rules, config/vyntex-build-pricing.json).
STRIPE_SECRET_KEY=
# Signing secret of the Stripe webhook endpoint (begins with whsec_), test mode first.
STRIPE_WEBHOOK_SECRET=
